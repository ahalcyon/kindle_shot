#!/bin/sh
# kindle_shot: キャプチャ経路に触る push の前に実機スモークを走らせる
#
# キャプチャ層（Win32 のウィンドウ検出・画面キャプチャ・キーストローク送出）は
# ユニットテストでも CI でもカバーできない。PR を出す前にここだけは実機で
# 確認するためのフック。詳細は AGENTS.md「実機スモーク」を参照。
#
# 有効化（クローンごとに 1 回）:
#   git config core.hooksPath .githooks
#   git config kindleshot.smokeAsin B0XXXXXXXX
#   git config kindleshot.python kindle_env/Scripts/python.exe   # 任意
#
# どの Python が使われるかの確認:
#   .githooks/pre-push --check
#
# 迂回（実機が使えないときなど。PR に未検証である旨を必ず書くこと）:
#   git push --no-verify

set -e

# git config に入っているパスが Windows 形式 (C:\... / C:/...) のとき、WSL の sh は
# それを exec できず 127 で落ちる（Git Bash は解決できるので通る）。exe 自体は
# interop で起動できるので、wslpath がある環境でだけ POSIX 形式へ直す。
to_unix_path() {
    case "$1" in
        [A-Za-z]:[/\\]*)
            # wslpath は「WSL にマウントされていないドライブ」で失敗する。
            # set -e 下ではコマンド置換の失敗がそのままフックの終了になり、
            # 後段の親切なエラーに届かないまま push が黙って止まる。
            # 変換できなければ元の値を返し、判断は起動確認に委ねる。
            if command -v wslpath >/dev/null 2>&1; then
                wslpath -u "$1" 2>/dev/null || printf '%s' "$1"
            else
                printf '%s' "$1"
            fi
            ;;
        *)
            printf '%s' "$1"
            ;;
    esac
}

# 使う Python を決める。git config の指定 → リポジトリ内の venv → PATH の python。
resolve_python() {
    configured=$(git config kindleshot.python || true)
    if [ -n "$configured" ]; then
        to_unix_path "$configured"
        return
    fi
    # setup.bat が作る kindle_env が正典（README「動作環境」）。手で作った .venv も
    # 拾うが、両方ある環境で依存の入っていない方を選ばないよう正典を先に見る。
    for candidate in kindle_env/Scripts/python.exe .venv/Scripts/python.exe \
                     kindle_env/bin/python .venv/bin/python; do
        if [ -x "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    done
    printf '%s' python
}

# 解決結果だけ見たいとき（git がフックに渡すのは <remote> <url> なので衝突しない）
if [ "$1" = "--check" ]; then
    checked=$(resolve_python)
    # echo は dash でバックスラッシュをエスケープとして解釈する（C:\temp が
    # C:<TAB>emp になる）。Windows パスを見せるのが目的なので printf を使う。
    printf 'python: %s\n' "$checked"
    if "$checked" -c "import sys" >/dev/null 2>&1; then
        printf 'status: 起動できました\n'
    else
        printf 'status: 起動できません（この状態では push がブロックされます）\n'
    fi
    printf 'asin:   %s\n' "$(git config kindleshot.smokeAsin || echo '(未設定)')"
    exit 0
fi

# 実機確認が要るファイル。AGENTS.md の一覧と合わせること。
#
# **どちらのスモークが通るかでファイルを分ける。** 以前は 1 本の一覧を
# headless スモークだけで守っていたが、headless は capture_engine /
# capture_runner / reader_navigator を 1 行も実行しない。つまり
# 「実機で確認した」という記録が実態を伴っていなかった (#50)。
#
# **両方に入るファイルがある。** 分け方の規準は「どちらか一方に入れる」では
# なく「**検証できる経路すべてに入れる**」。共有部分を headless 側だけに
# 置くと、画面側でしか確かめられない部分が無検証のまま通る。
#   cli.py             run --no-headless の配線は --screen でしか通らない
#   capture_profiles   headless が使うのは get_profile/to_dict だけ。
#                      timeout_seconds / settle_* / click_position /
#                      window_title_keyword は画面経路でしか効かない
#   boundary_detector  headless 側の検証範囲は smokeAsin に何を設定したかで
#                      変わる。画面経路は必ずマージン自動検出を通る
#   pipeline           headless / 画面の分岐そのものがここにある
#   smoke_capture      --screen の配線（--no-headless を組み立てる所）は
#                      画面スモークでしか通らない。スモーク自身が両方に要る
#
# SCREEN_RE: 画面キャプチャ経路で検証できる。--screen が要る（デスクトップを占有）
SCREEN_RE='^(core/capture_engine\.py|core/capture_runner\.py|core/reader_navigator\.py|core/win32_utils\.py|core/capture_profiles\.py|core/boundary_detector\.py|core/pipeline\.py|cli\.py|scripts/smoke_capture\.py)$'
# HEADLESS_RE: headless で検証できる
HEADLESS_RE='^(core/headless_capture\.py|core/headless_browser\.py|core/capture_profiles\.py|core/boundary_detector\.py|core/pipeline\.py|cli\.py|scripts/smoke_capture\.py)$'

ZERO='0000000000000000000000000000000000000000'
changed=''

while read -r _local_ref local_sha _remote_ref remote_sha; do
    # ブランチ削除の push は対象外
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # 新規ブランチ: 既定ブランチとの分岐点から見る
        base=$(git merge-base origin/master "$local_sha" 2>/dev/null || true)
    else
        base="$remote_sha"
    fi

    if [ -n "$base" ]; then
        changed="$changed$(git diff --name-only "$base" "$local_sha")
"
    else
        changed="$changed$(git ls-tree -r --name-only "$local_sha")
"
    fi
done

screen_hits=$(printf '%s' "$changed" | grep -E "$SCREEN_RE" | sort -u || true)
headless_hits=$(printf '%s' "$changed" | grep -E "$HEADLESS_RE" | sort -u || true)

if [ -z "$screen_hits" ] && [ -z "$headless_hits" ]; then
    exit 0
fi

echo "pre-push: キャプチャ経路の変更を検出しました:"
[ -n "$headless_hits" ] && printf '  [headless] %s\n' $headless_hits
[ -n "$screen_hits" ] && printf '  [画面]     %s\n' $screen_hits
echo ""

ASIN=$(git config kindleshot.smokeAsin || true)
if [ -z "$ASIN" ]; then
    echo "pre-push: 実機スモークに使う ASIN が未設定のため push を中止します。" >&2
    echo "" >&2
    echo "  git config kindleshot.smokeAsin B0XXXXXXXX" >&2
    echo "" >&2
    echo "実機が使えない場合は git push --no-verify で迂回できます。" >&2
    echo "その場合は PR に未検証である旨と範囲を必ず書いてください。" >&2
    exit 1
fi

PY=$(resolve_python)

if ! probe=$("$PY" -c "import sys" 2>&1 >/dev/null); then
    printf 'pre-push: Python を実行できませんでした: %s\n' "$PY" >&2
    # not found / DLL ロード失敗 / Store のスタブ は原因も対処も違う
    [ -n "$probe" ] && printf '  %s\n' "$(printf '%s' "$probe" | head -n 1)" >&2
    echo "" >&2
    echo "スモークの失敗ではなく、実行環境の問題です。" >&2
    echo "使う Python を指定するには:" >&2
    echo "" >&2
    printf '  git config kindleshot.python kindle_env/Scripts/python.exe\n' >&2
    echo "" >&2
    echo "解決結果は .githooks/pre-push --check で確認できます。" >&2
    exit 1
fi

printf 'pre-push: ASIN=%s python=%s\n' "$ASIN" "$PY"
echo ""

fail() {
    echo "" >&2
    printf 'pre-push: %s のスモークに失敗したため push を中止しました。\n' "$1" >&2
    echo "迂回するには git push --no-verify を使い、PR に理由を書いてください。" >&2
    exit 1
}

if [ -n "$headless_hits" ]; then
    printf 'pre-push: 実機スモーク（headless。画面は占有しません）\n'
    "$PY" scripts/smoke_capture.py --asin "$ASIN" || fail headless
fi

if [ -n "$screen_hits" ]; then
    echo ""
    printf 'pre-push: 実機スモーク（画面キャプチャ。**デスクトップを占有します**）\n'
    printf '          ブラウザが全画面になり、マウスが別モニタへ退避します。\n'
    printf '          終わるまで触らないでください。\n'
    "$PY" scripts/smoke_capture.py --asin "$ASIN" --screen || fail 画面キャプチャ
fi

echo ""
echo "pre-push: 実機スモーク OK。push を続行します。"
exit 0
