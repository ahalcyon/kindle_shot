#!/bin/sh
# kindle_shot: キャプチャ経路に触る push の前に実機スモークを走らせる
#
# キャプチャ層（Win32 のウィンドウ検出・画面キャプチャ・キーストローク送出）は
# ユニットテストでも CI でもカバーできない。PR を出す前にここだけは実機で
# 確認するためのフック。詳細は AGENTS.md「実機スモーク」を参照。
#
# 有効化（クローンごとに 1 回）:
#   git config core.hooksPath .githooks
#   git config kindleshot.smokeAsin B0XXXXXXXX
#   git config kindleshot.python .venv/Scripts/python.exe        # 任意
#
# どの Python が使われるかの確認:
#   .githooks/pre-push --check
#
# 迂回（実機が使えないときなど。PR に未検証である旨を必ず書くこと）:
#   git push --no-verify

set -e

# git config に入っているパスが Windows 形式 (C:\... / C:/...) のとき、WSL の sh は
# それを exec できず 127 で落ちる（Git Bash は解決できるので通る）。exe 自体は
# interop で起動できるので、wslpath がある環境でだけ POSIX 形式へ直す。
to_unix_path() {
    case "$1" in
        [A-Za-z]:[/\\]*)
            if command -v wslpath >/dev/null 2>&1; then
                wslpath -u "$1"
            else
                printf '%s' "$1"
            fi
            ;;
        *)
            printf '%s' "$1"
            ;;
    esac
}

# 使う Python を決める。git config の指定 → リポジトリ内の venv → PATH の python。
resolve_python() {
    configured=$(git config kindleshot.python || true)
    if [ -n "$configured" ]; then
        to_unix_path "$configured"
        return
    fi
    for candidate in .venv/Scripts/python.exe kindle_env/Scripts/python.exe \
                     .venv/bin/python kindle_env/bin/python; do
        if [ -x "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    done
    printf '%s' python
}

# 解決結果だけ見たいとき（git がフックに渡すのは <remote> <url> なので衝突しない）
if [ "$1" = "--check" ]; then
    echo "python: $(resolve_python)"
    echo "asin:   $(git config kindleshot.smokeAsin || echo '(未設定)')"
    exit 0
fi

# 実機確認が要るファイル。AGENTS.md の一覧と合わせること。
# headless_* は kindle_cloud プロファイルの既定経路＝本番のキャプチャ経路なので、
# 画面キャプチャ側 (capture_*) と同じく実機でしか壊れが分からない。
WATCH_RE='^(core/capture_engine\.py|core/capture_runner\.py|core/capture_profiles\.py|core/headless_capture\.py|core/headless_browser\.py|core/win32_utils\.py|core/dpi\.py|core/reader_navigator\.py|core/boundary_detector\.py|cli\.py|scripts/smoke_capture\.py)$'

ZERO='0000000000000000000000000000000000000000'
changed=''

while read -r _local_ref local_sha _remote_ref remote_sha; do
    # ブランチ削除の push は対象外
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # 新規ブランチ: 既定ブランチとの分岐点から見る
        base=$(git merge-base origin/master "$local_sha" 2>/dev/null || true)
    else
        base="$remote_sha"
    fi

    if [ -n "$base" ]; then
        changed="$changed$(git diff --name-only "$base" "$local_sha")
"
    else
        changed="$changed$(git ls-tree -r --name-only "$local_sha")
"
    fi
done

hits=$(printf '%s' "$changed" | grep -E "$WATCH_RE" | sort -u || true)

if [ -z "$hits" ]; then
    exit 0
fi

echo "pre-push: キャプチャ経路の変更を検出しました:"
printf '  %s\n' $hits
echo ""

ASIN=$(git config kindleshot.smokeAsin || true)
if [ -z "$ASIN" ]; then
    echo "pre-push: 実機スモークに使う ASIN が未設定のため push を中止します。" >&2
    echo "" >&2
    echo "  git config kindleshot.smokeAsin B0XXXXXXXX" >&2
    echo "" >&2
    echo "実機が使えない場合は git push --no-verify で迂回できます。" >&2
    echo "その場合は PR に未検証である旨と範囲を必ず書いてください。" >&2
    exit 1
fi

PY=$(resolve_python)

if ! "$PY" -c "import sys" >/dev/null 2>&1; then
    echo "pre-push: Python を実行できませんでした: $PY" >&2
    echo "" >&2
    echo "スモークの失敗ではなく、実行環境の問題です。" >&2
    echo "使う Python を指定するには:" >&2
    echo "" >&2
    echo "  git config kindleshot.python .venv/Scripts/python.exe" >&2
    echo "" >&2
    echo "解決結果は .githooks/pre-push --check で確認できます。" >&2
    exit 1
fi

echo "pre-push: 実機スモークを実行します（デスクトップを占有します）"
echo "          ASIN=$ASIN python=$PY"
echo ""

if "$PY" scripts/smoke_capture.py --asin "$ASIN"; then
    echo ""
    echo "pre-push: 実機スモーク OK。push を続行します。"
    exit 0
fi

echo "" >&2
echo "pre-push: 実機スモークに失敗したため push を中止しました。" >&2
echo "迂回するには git push --no-verify を使い、PR に理由を書いてください。" >&2
exit 1
