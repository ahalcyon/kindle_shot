  "regex": [
    {
      "_comment": "数字に挟まれた大文字 O は 0 の誤認識として扱う",
      "pattern": "(?<=\\d)O(?=\\d)",
      "replace": "0"
    },
    {
      "_comment": "数字に挟まれた l (小文字エル) は 1 の誤認識として扱う",
      "pattern": "(?<=\\d)l(?=\\d)",
      "replace": "1"
    },
    {
      "_comment": "ブロード。アップロード / ループロード の中には当てない（行またぎの アッ+改行+プロード も含む）",
      "pattern": "(?<![ッツー])(?<!ッ\\s)(?<!ッ\\s\\s)プロード",
      "replace": "ブロード"
    },
    {
      "_comment": "ブーム。スワンナプーム空港（行またぎの断片も）/ プームポーン は除く",
      "pattern": "(?<!ンナ)プーム(?!ポーン|国際空港)",
      "replace": "ブーム"
    },
    {
      "_comment": "ブロンド。エプロンドレス は除く",
      "pattern": "(?<!エ)プロンド",
      "replace": "ブロンド"
    },
    {
      "_comment": "ナッツ。ナツツバキ(夏椿) は除く",
      "pattern": "ナツツ(?!バキ)",
      "replace": "ナッツ"
    },
    {
      "_comment": "キーパー。コーキーバーク(corky bark) は除く",
      "pattern": "キーバー(?!ク)",
      "replace": "キーパー"
    },
    {
      "_comment": "バンパー。バンバーガー(Bamberger) は除く",
      "pattern": "バンバー(?!ガー)",
      "replace": "バンパー"
    },
    {
      "_comment": "ポーチ。ボーチャード / ボーチャーズ / ボーチャイ は除く",
      "pattern": "ボーチ(?!ャ)",
      "replace": "ポーチ"
    },
    {
      "_comment": "ポーター。ボーター帽子(boater) は除く",
      "pattern": "ボーター(?!帽子)",
      "replace": "ポーター"
    },
    {
      "_comment": "アプリ。スクエアブリストル / アブリーゴ は除く。アブリケーションは literal で先に直る",
      "pattern": "(?<!エ)アブリ(?!ーゴ)",
      "replace": "アプリ"
    },
    {
      "_comment": "ポルノ。シンボルノル のような シンボル+ノ〜 は除く",
      "pattern": "(?<!シン)ボルノ",
      "replace": "ポルノ"
    },
    {
      "_comment": "ポルシェ。ボルシェビキ / ボルシェヴィキ は除く",
      "pattern": "ボルシェ(?![ビヴ])",
      "replace": "ポルシェ"
    }
